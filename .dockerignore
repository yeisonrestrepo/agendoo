# =====================================
# .dockerignore para Agendoo API
# Optimiza el contexto de build excluyendo archivos innecesarios
# =====================================

# =====================================
# Node.js
# =====================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*
.yarn/

# =====================================
# Build outputs
# =====================================
dist/
build/
coverage/
.nyc_output/

# =====================================
# Environment y configuración
# =====================================
.env*
!.env.example
*.local
.env.development
.env.test
.env.production

# =====================================
# Logs
# =====================================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# =====================================
# Temporary files
# =====================================
.tmp/
.temp/
tmp/
temp/

# =====================================
# IDE y editors
# =====================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# =====================================
# Sistema operativo
# =====================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =====================================
# Git
# =====================================
.git/
.gitignore
.gitattributes
.gitmodules

# =====================================
# Testing
# =====================================
test/
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
jest.config.*

# =====================================
# Documentation y desarrollo
# =====================================
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/
documentation/
*.md

# =====================================
# Docker files (evitar recursión)
# =====================================
Dockerfile*
docker-compose*.yml
.dockerignore

# =====================================
# Scripts de desarrollo
# =====================================
scripts/
tools/
devtools/

# =====================================
# Archivos de ejemplo y plantillas
# =====================================
*.example
*.template
*.sample

# =====================================
# Uploads y archivos de usuario (desarrollo)
# =====================================
uploads/
media/
static/
public/uploads/

# =====================================
# Backup files
# =====================================
*.bak
*.backup
*.old
*.orig

# =====================================
# Package managers lock files (excepto yarn.lock)
# =====================================
package-lock.json

# =====================================
# Herramientas específicas del proyecto
# =====================================
.eslintcache
.prettierignore
.stylelintrc*
tsconfig.tsbuildinfo